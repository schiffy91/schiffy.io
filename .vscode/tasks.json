{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
			"label": "open website",
			"type": "shell",
			"command": "\"$BROWSER\" docs/index.html",
			"dependsOn": [
				"build html"
			],
			"group": "build"
		},
		{
			"label": "build html",
			"type": "shell",
			"command": "make html",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "rebuild portfolio",
			"type": "shell",
			"command": "make img",
			"group":"build"
		},
	]
}